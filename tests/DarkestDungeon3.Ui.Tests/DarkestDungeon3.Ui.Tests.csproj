<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <SpineArtSource Condition="'$(SpineArtSource)' == ''">../../src/DarkestDungeon3/Runtime/SpineArt.cs</SpineArtSource>
    <ItemTextSource Condition="'$(ItemTextSource)' == ''">../../src/DarkestDungeon3/Dd2/ItemText.cs</ItemTextSource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <ProjectReference Include="../../src/DarkestDungeon3.Core/DarkestDungeon3.Core.csproj" />
    <Compile Include="../../src/DarkestDungeon3/Ui/Drag.cs" Link="Drag.cs" />
    <Compile Include="../../src/DarkestDungeon3/Dd2/PostEffectGuard.cs" Link="PostEffectGuard.cs" />
    <Compile Include="../../src/DarkestDungeon3/Dd2/DeferredPoll.cs" Link="DeferredPoll.cs" />
    <Compile Include="../../src/DarkestDungeon3/Runtime/SpriteArt.cs" Link="SpriteArt.cs" />
    <Compile Include="$(SpineArtSource)" Link="SpineArt.cs" />
    <Compile Include="$(ItemTextSource)" Link="ItemText.cs" />
  </ItemGroup>
</Project>
